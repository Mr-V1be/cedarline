# Copy to `.env` in the repository root and fill in the values.
# The web app, the Payload CLI and Docker Compose all read this single file.

# PostgreSQL started by `docker compose up -d postgres` (published on 127.0.0.1:46132).
POSTGRES_DB=
POSTGRES_USER=
# Any strong password, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:46132/<POSTGRES_DB>
DATABASE_URL=

# Payload CMS secret used to sign sessions, e.g. `openssl rand -hex 32`.
PAYLOAD_SECRET=

# Public origin of the site without a trailing slash (http://localhost:46100 locally).
SITE_URL=
