# Copy to `.env` in the repository root and fill in the values.
# The web app, the Payload CLI and Docker Compose all read this single file.

# PostgreSQL started by `docker compose up -d postgres` (published on 127.0.0.1:46132).
POSTGRES_DB=
POSTGRES_USER=
# Any strong password, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:46132/<POSTGRES_DB>
DATABASE_URL=

# Payload CMS secret used to sign sessions, e.g. `openssl rand -hex 32`.
PAYLOAD_SECRET=

# Public origin of the site without a trailing slash (http://localhost:46100 locally).
SITE_URL=

# Where outgoing mail goes: `demo` (default) keeps every letter in the site's demo mailbox and
# shows the customer a link to their copy; `smtp` sends through the relay below.
MAIL_MODE=
# SMTP relay, required for MAIL_MODE=smtp. Locally: Mailpit from `docker compose up -d mailpit`
# (SMTP on 127.0.0.1:46125, web UI on http://localhost:46180); user and password stay empty.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Sender of customer and staff emails, e.g. hello@kedrovnik.example and «Кедровник».
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Where leads go, comma-separated, first one must succeed: `cms` (leads in the CMS) and
# optionally `bitrix24` (external CRM over its REST webhook). Default: cms.
LEAD_SINKS=
# Incoming webhook of the CRM: https://<portal>/rest/<user>/<token>/ — locally the CRM mock
# from `docker compose up -d crm-mock`: http://127.0.0.1:46140/rest/1/<CRM_MOCK_TOKEN>/
BITRIX24_WEBHOOK_URL=
# Token the CRM mock accepts in its webhook path, e.g. `openssl rand -hex 16`.
CRM_MOCK_TOKEN=

# Base map styles (MapLibre style JSON) for the light and dark themes. Empty: OpenFreeMap
# Positron and Dark, which need no key.
MAP_STYLE_LIGHT_URL=
MAP_STYLE_DARK_URL=

# Bank of Russia DailyInfo web service for the key rate in the calculator. Empty: cbr.ru.
CBR_DAILY_INFO_URL=
