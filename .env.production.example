# Production settings for docker-compose.prod.yml. Copy to `.env.production` on the server,
# fill in every value and keep the file there only (it is ignored by git).
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# Public address. Caddy obtains the TLS certificate for SITE_DOMAIN from Let's Encrypt and
# sends expiry notices to ACME_EMAIL. SITE_URL is the same address with https://.
SITE_DOMAIN=
ACME_EMAIL=
SITE_URL=

# Published ports of Caddy (defaults 80 and 443).
HTTP_PORT=
HTTPS_PORT=

# PostgreSQL inside the stack; the site reaches it at postgres:5432.
POSTGRES_DB=
POSTGRES_USER=
# A long random password, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
DATABASE_URL=

# Signs CMS sessions, e.g. `openssl rand -hex 32`. Changing it signs everybody out.
PAYLOAD_SECRET=

# Mail: `smtp` sends through the relay below; `demo` keeps letters in the site's demo mailbox.
MAIL_MODE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Where leads go: `cms`, or `cms,bitrix24` with the CRM's incoming webhook.
LEAD_SINKS=
BITRIX24_WEBHOOK_URL=
# Demo stands with `--profile demo` only: the token of the CRM mock's webhook path.
CRM_MOCK_TOKEN=

# Optional: map styles and the Bank of Russia service; empty means the defaults.
MAP_STYLE_LIGHT_URL=
MAP_STYLE_DARK_URL=
CBR_DAILY_INFO_URL=

# `true` only on a public demo stand: one-click CMS sign-in and the nightly reset to the seed.
DEMO_MODE=

# Server time zone for scheduled jobs and backups (default Europe/Moscow).
TZ=
# Nightly backups: time of day and how many days to keep (defaults 03:00 and 14).
BACKUP_TIME=
BACKUP_KEEP_DAYS=
